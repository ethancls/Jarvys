model AllowedStudentNumber {
  id     String @id @default(cuid())
  number String @unique
  label  String? // Optionnel, pour afficher un nom ou une info
  createdAt DateTime @default(now())
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // L'output a été déplacé dans le dossier lib/generated/prisma, ce qui est une bonne pratique.
  // Assurez-vous que ce chemin est correct pour votre structure.
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id           String     @id @default(cuid())
  number       String     @unique // Numéro étudiant unique
  passwordHash String
  isAdmin      Boolean    @default(false)
  firstname    String
  lastname     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  logs         Log[]      // Relation vers les logs de l'étudiant
  solutions    Solution[] // Relation vers les solutions de l'étudiant
}

model Exercise {
  id                    String     @id @default(cuid())
  title                 String
  description           String     @db.Text // Utiliser Text pour les descriptions potentiellement longues
  inputExample          String?    // Renommé pour plus de clarté
  expectedOutputExample String?    // Renommé pour plus de clarté
  testCases             Json       // Stocke le tableau de cas de test [{ input, expected_output, description, hidden? }]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  logs                  Log[]      // Relation vers les logs pour cet exercice
  solutions             Solution[] // Relation vers les solutions pour cet exercice
  // Ajouter potentiellement: difficulty String?, tags String[]?
}

model Log {
  id         String    @id @default(cuid())
  studentId  String
  exerciseId String
  code       Json      // Stocke le code soumis, potentiellement [{ name, content, isMain }]
  timestamp  DateTime  @default(now()) // Conserve le timestamp original de l'entrée JSON si besoin lors de la migration, sinon @default(now()) suffit
  success    Boolean?  // Résultat de l'exécution/test
  isAutoSave Boolean?  // Indique si c'est une sauvegarde automatique
  createdAt  DateTime  @default(now()) // Date de création de l'enregistrement Log
  updatedAt  DateTime  @updatedAt

  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade) // Relation vers Student
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade) // Relation vers Exercise

  @@index([studentId]) // Index pour améliorer les recherches par étudiant
  @@index([exerciseId]) // Index pour améliorer les recherches par exercice
}

model Solution {
  id         String   @id @default(cuid())
  studentId  String
  exerciseId String
  timestamp  DateTime @default(now())
  files      Json     // Stocke le tableau de fichiers [{ name, content, isMain }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Ajouter potentiellement: isCorrect Boolean?

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade) // Relation vers Student
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade) // Relation vers Exercise

  @@unique([studentId, exerciseId]) // Ajout de la contrainte unique
  @@index([studentId])
  @@index([exerciseId])
}
